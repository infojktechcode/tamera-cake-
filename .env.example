# --- Supabase -----------------------------------------------------------
# Project URL and public key. NEXT_PUBLIC_* vars are inlined into the browser
# bundle by Next.js, so only ever put public values behind that prefix.
NEXT_PUBLIC_SUPABASE_URL=
# Current Supabase CLI issues publishable keys (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias, still honoured if PUBLISHABLE_KEY is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only runtime secret key (sb_secret_...). Never prefix with NEXT_PUBLIC_.
# Required for checkout, order confirmation lookups, photo uploads, activity
# logging, and staff provisioning. It bypasses RLS.
SUPABASE_SECRET_KEY=
# Legacy alias, still honoured.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SHOP_WHATSAPP=

# --- Seed data (supabase/seed.sql) ---------------------------------------
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
